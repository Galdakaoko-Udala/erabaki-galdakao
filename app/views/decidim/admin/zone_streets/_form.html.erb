<div class="item_show__header">
  <div style="display:flex;flex-direction:column;flex:1;">
    <span style="font-size:0.85rem;color:#666;font-weight:500;margin-bottom:0.25rem;">
      <%= t("decidim.admin.galdakao.zones_index.title") %>
    </span>
    <h1 class="item_show__header-title" style="margin:0;">
      <%= @form.id ? "#{t('decidim.admin.galdakao.zone_streets.form.title_edit')}: #{zone.name}" : "#{t('decidim.admin.galdakao.zone_streets.form.title_new')}: #{zone.name}" %>
    </h1>
  </div>
</div>
<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for @form, url: (@form.id ? decidim_admin_galdakao_census.galdakao_zone_zone_street_path(zone, @form.id) : decidim_admin_galdakao_census.galdakao_zone_zone_streets_path(zone)), html: { class: "form form-defaults" } do |f| %>
      <div class="field" style="margin-bottom:1rem;">
        <label for="galdakao_zone_street_street_id"><%= t("decidim.admin.galdakao.zone_streets.form.street_label") %></label>
        <%= f.select :street_id,
            GaldakaoStreet.where(organization: current_organization).order(name: :asc).map { |s| [s.name, s.id] },
            { include_blank: t("decidim.admin.galdakao.zone_streets.form.street_blank") },
            id: "galdakao_zone_street_street_id",
            label: false,
            style: "padding:3px 35px 3px 3px;margin-left:5px;" %>
      </div>
      <div class="field" style="margin-bottom:1rem;">
        <label for="zone_street_numbers_constraint"><%= t("decidim.admin.galdakao.zone_streets.form.numbers_constraint_label") %></label>
        <%= f.select :numbers_constraint,
            @form.numbers_constraint_options.to_a,
            {},
            id: "zone_street_numbers_constraint",
            label: false,
            style: "padding:3px 35px 3px 3px;margin-left:5px;" %>
      </div>
      <div class="field" id="numbers_range_field" style="display:none;margin-bottom:1rem;">
        <label for="galdakao_zone_street_numbers_range"><%= t("decidim.admin.galdakao.zone_streets.form.numbers_range_label") %></label>
        <%= f.text_field :numbers_range, placeholder: t("decidim.admin.galdakao.zone_streets.form.numbers_range_placeholder"), label: false %>
        <p class="help-text"><%= t("decidim.admin.galdakao.zone_streets.form.numbers_range_help").html_safe %></p>
      </div>
      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= f.submit t("decidim.admin.galdakao.zone_streets.form.submit"), class: "button button__sm button__secondary" %>
          <%= link_to decidim_admin_galdakao_census.galdakao_zone_path(zone),
              style: "display:inline-flex;align-items:center;gap:0.5rem;border:2px solid var(--secondary);color:var(--secondary);border-radius:4px;font-weight:600;padding:1.375px 10px;font-size:0.875rem;text-decoration:none;background:transparent;",
              onmouseover: "this.style.background='var(--secondary)';this.style.color='white'",
              onmouseout: "this.style.background='transparent';this.style.color='var(--secondary)'" do %>
            <%= icon "arrow-left-line", class: "fill-current" %>
            <span><%= t("decidim.admin.galdakao.zone_streets.form.cancel") %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<script>
  (function() {
    const RANGE_CONSTRAINTS = ["only_range", "except_range"];
    const select = document.getElementById("zone_street_numbers_constraint");
    const field  = document.getElementById("numbers_range_field");
    function toggle() {
      field.style.display = RANGE_CONSTRAINTS.includes(select.value) ? "" : "none";
    }
    select.addEventListener("change", toggle);
    toggle();
  })();
</script>
