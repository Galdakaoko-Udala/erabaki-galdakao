<!-- insert_after "tbody tr td.\\!text-left" -->
<td class="!text-left">
  <% if workflow.key == "census_authorization_handler" %>
    <div class="flex gap-2">
      <%= link_to t("decidim.galdakao_census.admin.authorization_workflows.streets"), decidim_admin_galdakao_census.streets_path, class: "button button__sm button__secondary", style: "color: #fff" %>
      <%= link_to t("decidim.galdakao_census.admin.authorization_workflows.zones"), decidim_admin_galdakao_census.zones_path, class: "button button__sm button__secondary", style: "color: #fff" %>
    </div>
  <% end %>
</td>
