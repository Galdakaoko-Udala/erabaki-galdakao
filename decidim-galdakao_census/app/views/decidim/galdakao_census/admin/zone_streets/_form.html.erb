<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">
      <div class="row column">
        <%= form.select :street_id, form.object.street_options, include_blank: t(".street_blank") %>
      </div>
      <div class="row column">
        <%= form.select :numbers_constraint, form.object.numbers_constraint_options %>
      </div>
      <div id="numbers_range_field" class="hidden">
        <div class="row column">
          <%= form.text_field :numbers_range,
                              placeholder: t(".numbers_range_placeholder"),
                              help_text: t(".numbers_range_help_html") %>
        </div>
      </div>
    </div>
  </div>
</div>
