<% add_decidim_page_title(t("decidim.admin.galdakao.zone_streets.form.title_new")) %>
<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("decidim.admin.galdakao.zone_streets.form.title_new") %>: <%= zone.name %>
    <%= link_to t("decidim.admin.galdakao.zone_streets.form.cancel"),
                decidim_admin_galdakao_census.galdakao_zone_path(zone),
                class: "button button__transparent-secondary button__sm" %>
  </h1>
</div>
<div class="item__edit-form">
  <%= decidim_form_for(@form, url: decidim_admin_galdakao_census.galdakao_zone_zone_streets_path(zone), html: { class: "form-defaults form new_zone_street" }) do |f| %>
    <%= render partial: "form", object: f %>
    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%= f.submit t("decidim.admin.galdakao.zone_streets.form.submit"), class: "button button__sm button__secondary" %>
      </div>
    </div>
  <% end %>
</div>
