<% add_decidim_page_title(t(".title")) %>
<div class="card" id="census-streets">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <% if allowed_to? :sync, :census_street %>
        <%= link_to t(".sync"), sync_streets_path, method: :post, data: { confirm: t(".sync_confirm") }, class: "button button__sm button__secondary" %>
      <% end %>
      <%= link_to t(".back"), decidim_admin.authorization_workflows_path, class: "button button__sm button__transparent-secondary" %>
    </h1>
  </div>

  <% if last_sync %>
    <div class="callout <%= last_sync_class(last_sync) %>">
      <%= t(".last_sync", time: l(last_sync, format: :long)) %>
    </div>
  <% else %>
    <div class="callout warning">
      <%= t(".never_synced") %>
    </div>
  <% end %>

  <% if streets.any? %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".updated_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% streets.each do |street| %>
            <tr>
              <td data-label="<%= t(".name") %>"><%= street.name %></td>
              <td data-label="<%= t(".updated_at") %>"><%= l(street.updated_at, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= decidim_paginate streets %>
  <% end %>
</div>
