<% add_decidim_page_title(t(".title")) %>
<div class="card" id="census-zones">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <% if allowed_to? :create, :census_zone %>
        <%= link_to t(".new"), new_zone_path, class: "button button__sm button__secondary new" %>
      <% end %>
      <%= link_to t(".back"), decidim_admin.authorization_workflows_path, class: "button button__sm button__transparent-secondary" %>
    </h1>
  </div>

  <% if zones.any? %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".streets") %></th>
            <th><%= t("decidim.admin.actions.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% zones.each do |zone| %>
            <tr>
              <td data-label="<%= t(".name") %>"><%= link_to zone.name, zone_path(zone) %></td>
              <td data-label="<%= t(".streets") %>"><%= zone.zone_streets.size %></td>
              <td class="table-list__actions" data-label="<%= t("decidim.admin.actions.actions") %>">
                <button type="button" data-controller="dropdown" data-target="actions-zone-<%= zone.id %>" aria-label="<%= t("decidim.admin.actions.actions_label", resource: zone.name) %>">
                  <%= icon "more-fill", class: "text-secondary" %>
                </button>

                <div class="inline-block relative">
                  <ul id="actions-zone-<%= zone.id %>" class="dropdown dropdown__action" aria-hidden="true">
                    <% if allowed_to? :update, :census_zone %>
                      <li class="dropdown__item">
                        <%= link_to edit_zone_path(zone), class: "dropdown__button" do %>
                          <%= icon "pencil-line" %>
                          <%= t("actions.edit", scope: "decidim.admin") %>
                        <% end %>
                      </li>
                    <% end %>

                    <% if allowed_to? :destroy, :census_zone %>
                      <hr>

                      <li class="dropdown__item">
                        <%= link_to zone_path(zone), method: :delete, data: { confirm: t("actions.confirm_destroy", scope: "decidim.admin") }, class: "dropdown__button" do %>
                          <%= icon "delete-bin-line" %>
                          <%= t("actions.destroy", scope: "decidim.admin") %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= decidim_paginate zones %>
  <% else %>
    <p><%= t(".no_zones") %></p>
  <% end %>
</div>
