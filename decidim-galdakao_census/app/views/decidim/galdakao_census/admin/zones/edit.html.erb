<% add_decidim_page_title(t(".title", name: zone.name)) %>
<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t(".title", name: zone.name) %>
    <%= link_to t(".back"), zone_path(zone), class: "button button__sm button__transparent-secondary" %>
  </h1>
</div>
<div class="item__edit-form">
  <%= decidim_form_for(@form, url: zone_path(zone), html: { class: "form-defaults form edit_zone" }) do |f| %>
    <%= render partial: "form", object: f %>
    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%= f.submit t(".update"), class: "button button__sm button__secondary" %>
      </div>
    </div>
  <% end %>
</div>
