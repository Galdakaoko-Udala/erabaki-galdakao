<% add_decidim_page_title(zone.name) %>
<div class="card" id="census-zone">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= zone.name %>
      <% if allowed_to? :update, :census_zone %>
        <%= link_to t(".edit"), edit_zone_path(zone), class: "button button__sm button__secondary" %>
      <% end %>
      <%= link_to t(".back"), zones_path, class: "button button__sm button__transparent-secondary" %>
    </h1>
  </div>

  <div class="item_show__header">
    <h2 class="item_show__header-title">
      <%= t(".streets") %>
      <% if allowed_to? :create, :census_zone_street %>
        <%= link_to t(".add_street"), new_zone_zone_street_path(zone), class: "button button__sm button__secondary new" %>
      <% end %>
    </h2>
  </div>

  <% if zone.zone_streets.any? %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".street") %></th>
            <th><%= t(".constraint") %></th>
            <th><%= t(".range") %></th>
            <th><%= t("decidim.admin.actions.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% zone.zone_streets.includes(:street).each do |zone_street| %>
            <tr>
              <td data-label="<%= t(".street") %>"><%= zone_street.street.name %></td>
              <td data-label="<%= t(".constraint") %>"><%= t(zone_street.numbers_constraint, scope: "decidim.galdakao_census.numbers_constraints") %></td>
              <td data-label="<%= t(".range") %>"><%= zone_street.numbers_range.presence || "-" %></td>
              <td class="table-list__actions" data-label="<%= t("decidim.admin.actions.actions") %>">
                <button type="button" data-controller="dropdown" data-target="actions-zone-street-<%= zone_street.id %>" aria-label="<%= t("decidim.admin.actions.actions_label", resource: zone_street.street.name) %>">
                  <%= icon "more-fill", class: "text-secondary" %>
                </button>

                <div class="inline-block relative">
                  <ul id="actions-zone-street-<%= zone_street.id %>" class="dropdown dropdown__action" aria-hidden="true">
                    <% if allowed_to? :update, :census_zone_street %>
                      <li class="dropdown__item">
                        <%= link_to edit_zone_zone_street_path(zone, zone_street), class: "dropdown__button" do %>
                          <%= icon "pencil-line" %>
                          <%= t("actions.edit", scope: "decidim.admin") %>
                        <% end %>
                      </li>
                    <% end %>

                    <% if allowed_to? :destroy, :census_zone_street %>
                      <hr>

                      <li class="dropdown__item">
                        <%= link_to zone_zone_street_path(zone, zone_street), method: :delete, data: { confirm: t("actions.confirm_destroy", scope: "decidim.admin") }, class: "dropdown__button" do %>
                          <%= icon "delete-bin-line" %>
                          <%= t("actions.destroy", scope: "decidim.admin") %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t(".no_streets") %></p>
  <% end %>
</div>
