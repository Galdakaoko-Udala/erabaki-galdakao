<%# Vista: /admin/galdakao/streets — Listado de calles sincronizadas %>
<% add_decidim_page_title(t("decidim.admin.galdakao.streets.title")) %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("decidim.admin.galdakao.streets.title") %>
      <%= link_to decidim_admin_galdakao_census.galdakao_index_path,
          style: "display:inline-flex;align-items:center;gap:0.5rem;border:2px solid var(--secondary);color:var(--secondary);border-radius:4px;font-weight:600;padding:1.375px 10px;font-size:0.875rem;text-decoration:none;background:transparent;",
          onmouseover: "this.style.background='var(--secondary)';this.style.color='white'",
          onmouseout: "this.style.background='transparent';this.style.color='var(--secondary)'" do %>
        <%= icon "arrow-left-line", class: "fill-current" %>
        <span><%= t("decidim.admin.galdakao.streets.nav_button") %></span>
      <% end %>
    </h1>
  </div>
  <div class="table-scroll">
    <table class="table-list">
      <thead>
        <tr>
          <th><%= t("decidim.admin.galdakao.streets.name") %></th>
          <th><%= t("decidim.admin.galdakao.streets.updated_at") %></th>
        </tr>
      </thead>
      <tbody>
        <% streets_list.each do |street| %>
          <tr>
            <td><%= street.name %></td>
            <td><%= l(street.updated_at, format: :short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= decidim_paginate streets_list %>
</div>
