<%# Vista: /admin/galdakao — Panel de gestión de calles %>
<% add_decidim_page_title(t("decidim.admin.galdakao.index.title")) %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("decidim.admin.galdakao.index.title") %>
      <%= link_to "/admin/authorization_workflows",
          style: "display:inline-flex;align-items:center;gap:0.5rem;border:2px solid var(--secondary);color:var(--secondary);border-radius:4px;font-weight:600;padding:1.375px 10px;font-size:0.875rem;text-decoration:none;background:transparent;",
          onmouseover: "this.style.background='var(--secondary)';this.style.color='white'",
          onmouseout: "this.style.background='transparent';this.style.color='var(--secondary)'" do %>
        <%= icon "arrow-left-line", class: "fill-current" %>
        <span><%= t("decidim.admin.galdakao.index.nav_button") %></span>
      <% end %>
    </h1>
  </div>
  <div class="card-divider">
    <h2 class="card-title">
      <%= t("decidim.admin.galdakao.index.section_sync.subtitle") %>
    </h2>
  </div>
  <div class="card__content">
    <% if last_sync %>
      <div class="callout success">
        <%= t("decidim.admin.galdakao.index.last_sync", time: l(last_sync, format: :long)) %>
      </div>
    <% else %>
      <div class="callout warning">
        <%= t("decidim.admin.galdakao.index.never_synced") %>
      </div>
    <% end %>
    <div class="mt-s" style="margin-bottom: 1rem;">
      <%= button_to t("decidim.admin.galdakao.index.sync_button"),
          decidim_admin_galdakao_census.sync_galdakao_index_path,
          method: :post,
          class: "button button__sm button__secondary",
          data: { confirm: t("decidim.admin.galdakao.index.sync_confirm") } %>
    </div>
    <div class="card-divider">
      <h2 class="card-title">
        <%= t("decidim.admin.galdakao.index.section_catalog.subtitle") %>
      </h2>
    </div>
    <div class="card__content">
      <div class="mt-s">
        <%= link_to t("decidim.admin.galdakao.index.streets_link"),
            decidim_admin_galdakao_census.streets_galdakao_index_path,
            class: "button button__sm button__secondary" %>
      </div>
    </div>
  </div>
</div>
